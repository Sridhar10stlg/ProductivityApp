generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String
  icon         String?
  color        String?
  type         String        // "EXPENSE" or "INCOME"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  budgets      Budget[]

  @@unique([name, type])
}

model Budget {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Float
  period     String   // "WEEKLY", "MONTHLY", "YEARLY"
  startDate  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

model Account {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  icon         String?
  color        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   // "EXPENSE" or "INCOME"
  amount      Float
  description String?
  date        DateTime
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([accountId])
  @@index([type])
}

// ─── To-Do Module ───────────────────────────────────

model TaskList {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String?
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  note        String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  important   Boolean   @default(false)
  myDay       Boolean   @default(false)
  myDayDate   DateTime?
  dueDate     DateTime?
  priority    String    @default("NONE") // NONE, LOW, MEDIUM, HIGH
  sortOrder   Int       @default(0)
  listId      Int?
  list        TaskList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  subtasks    SubTask[]

  @@index([listId])
  @@index([completed])
  @@index([dueDate])
  @@index([important])
}

model SubTask {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

// ─── Worklog Module ──────────────────────────────────

model WorklogEntry {
  id                     Int      @id @default(autoincrement())
  date                   DateTime
  natureOfWork           String?
  account                String?
  projectWork            String?
  importantTasksFeatures String?
  toolsTechSkills        String?
  remarks                String?
  attachments            String?
  priority               String   @default("NONE") // NONE, LOW, MEDIUM, HIGH
  rowColor               String?  // null | "gold" | "green" | "red"
  sourceType             String   @default("TASK") // TASK, SUBTASK, or MANUAL
  sourceId               Int?     // original Task or SubTask id
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([date])
}

// ─── Streaks Module ──────────────────────────────────
// Dates are stored as "YYYY-MM-DD" strings (not DateTime) so a habit day never shifts with timezones.
// Scores, results and streaks are computed from these rows, never stored.

model HabitSettings {
  id                  Int      @id @default(1)
  startDate           String   // day 1 of the plan, "YYYY-MM-DD"
  productiveThreshold Float    @default(0.5) // share of the day's Anchor habits to do for a productive day
  planCThreshold      Float    @default(0.63)
  weeklyGoal          Int      @default(5)
  bodyNeeded          Int      @default(2) // Body habits to do for a productive day
  brainNeeded         Int      @default(1) // Brain habits to do for a productive day
  gateEasy            Int      @default(30) // LeetCode phase 1 gate: easy problems
  gateTotal           Int      @default(80) // LeetCode phase 2 gate: total problems
  gateMedium          Int      @default(30) // LeetCode phase 2 gate: medium problems
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model HabitPhase {
  id           Int     @id @default(autoincrement())
  phase        Int     @unique
  startsInWeek Int
  brainNeeded  Int     @default(1)
  description  String?
}

model Habit {
  id              Int          @id @default(autoincrement())
  name            String       @unique
  group           String       // ANCHOR, BODY, BRAIN
  activeFromPhase Int          @default(1) // legacy: no longer used for scoring
  startDate       String?      // "YYYY-MM-DD": counts toward the daily total from this date; null = from the beginning
  points          Int          @default(1) // 1-5: weight of this habit in the daily score
  weekdays        String?      // "1,2,3,4,5" (0=Sun..6=Sat): days it is scheduled; null = every day
  weeklyTarget    Int?         // "do it N days a week" (any days, Monday to Sunday weeks); null = scheduled by weekdays
  sortOrder       Int          @default(0)
  archived        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  entries         HabitEntry[]
}

model HabitDay {
  id        Int          @id @default(autoincrement())
  date      String       @unique
  plan      String       @default("A") // A, B, C
  wellSpent Boolean      @default(false) // manual "day well spent": counts as a good day whatever the points say
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  entries   HabitEntry[]
}

// One row per habit marked on a day. A missing row means "missed" (blank in the spreadsheet).
model HabitEntry {
  id      Int      @id @default(autoincrement())
  dayId   Int
  day     HabitDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  habitId Int
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  status  String   // DONE, NA

  @@unique([dayId, habitId])
  @@index([habitId])
}

model LeetCodeEntry {
  id         Int      @id @default(autoincrement())
  date       String
  problem    String
  link       String?
  pattern    String?
  difficulty String   @default("EASY") // EASY, MEDIUM, HARD
  minutes    Int?
  solvedSolo Boolean  @default(true)
  redoDone   Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}
